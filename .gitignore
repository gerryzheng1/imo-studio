# Only the source directories below belong in work/. Keep local history intact.
/work/*/
!/work/default-input/
/work/default-input/*
!/work/default-input/cleaned/
/work/default-input/cleaned/*
!/work/default-input/cleaned/*.xlsx
!/work/reference-yzrt/
/work/reference-yzrt/*
